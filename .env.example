# Required for login and AI generation. Keep this file private.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://eastus2.api.cognitive.microsoft.com/
AZURE_OPENAI_DEPLOYMENT=fibu3-gpt5.6-terra-prod
AZURE_OPENAI_API_VERSION=2024-12-01-preview
APP_LOGIN_USER=fd25
APP_LOGIN_PASSWORD=fd25
PORT=4000

# Optional game email. Use the outgoing server from the hosttech access data sheet.
# Port 587 requires STARTTLS. For implicit TLS use port 465 and SMTP_SECURE=true.
# For local-only use, set APP_HOST=127.0.0.1. Hosted services require a private APP_LOGIN_PASSWORD.
# APP_HOST=127.0.0.1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional HTTPS relay for hosts that block outbound SMTP.
MAIL_RELAY_URL=
MAIL_RELAY_TOKEN=
MAIL_ACCESS_CODE=
